# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Secrets / local config
.env
.env.*
!.env.example
**/.streamlit/secrets.toml
# Google credential files. Not used: the Gemini key is only an environment variable (or .env /
# Streamlit secret); these stop one from being committed by accident.
client_secret*.json
*service-account*.json
*service_account*.json
application_default_credentials.json

# Data: keep the folder skeleton (.gitkeep), ignore contents
data/**
!data/**/
!data/**/.gitkeep

# Real XBRL filings must never be committed (NSE terms of use; see docs/adr/0002)
fixtures/xbrl/*.xml

# Data artefacts anywhere
*.duckdb
*.duckdb.wal
*.parquet

# dbt
dbt/target/
dbt/logs/
dbt/dbt_packages/
dbt/.user.yml
logs/

# Elementary report output
edr_target/

# BI exports (Week 12): rebuilt by dev.ps1 bi-export. exports/local holds raw filed values.
exports/local/
exports/public/*
!exports/public/.gitkeep
# the public Parquet files ARE committed (derived values only; the Streamlit app on Community
# Cloud reads them - docs/publication_policy.md). The workbooks stay out.
!exports/public/rpt_public_*.parquet

# Power BI project caches and personal settings (PBIP)
powerbi/**/.pbi/localSettings.json
powerbi/**/.pbi/cache.abf
*.abf

# Power BI backups / lock files
*.pbix.bak
*.pbit.bak
~$*.pbix
dashboards/**/backup/

# OS / editor
Thumbs.db
.DS_Store
