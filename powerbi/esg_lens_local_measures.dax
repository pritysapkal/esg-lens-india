// ESG Lens India - measures of the local model.
// Generated by scripts/build_powerbi.py; paste one at a time into New measure.

// [1 Coverage] Companies with a report in the current selection (semantic layer: companies_reporting).
Companies in selection =
    DISTINCTCOUNT ( fct_company_year[isin] )

// [1 Coverage] Companies with a value for ghg_intensity_tco2e_per_cr: the count that decides whether a group figure built on it may be shown publicly (5 or more).
Companies with GHG intensity =
    CALCULATE ( DISTINCTCOUNT ( fct_company_year[isin] ), NOT ISBLANK ( fct_company_year[ghg_intensity_tco2e_per_cr] ) )

// [1 Coverage] Companies with a value for energy_intensity_gj_per_cr: the count that decides whether a group figure built on it may be shown publicly (5 or more).
Companies with energy intensity =
    CALCULATE ( DISTINCTCOUNT ( fct_company_year[isin] ), NOT ISBLANK ( fct_company_year[energy_intensity_gj_per_cr] ) )

// [1 Coverage] Companies with a value for water_intensity_kl_per_cr: the count that decides whether a group figure built on it may be shown publicly (5 or more).
Companies with water intensity =
    CALCULATE ( DISTINCTCOUNT ( fct_company_year[isin] ), NOT ISBLANK ( fct_company_year[water_intensity_kl_per_cr] ) )

// [1 Coverage] Companies with a value for waste_intensity_t_per_cr: the count that decides whether a group figure built on it may be shown publicly (5 or more).
Companies with waste intensity =
    CALCULATE ( DISTINCTCOUNT ( fct_company_year[isin] ), NOT ISBLANK ( fct_company_year[waste_intensity_t_per_cr] ) )

// [1 Coverage] Companies with a value for renewable_share_pct: the count that decides whether a group figure built on it may be shown publicly (5 or more).
Companies with renewable share =
    CALCULATE ( DISTINCTCOUNT ( fct_company_year[isin] ), NOT ISBLANK ( fct_company_year[renewable_share_pct] ) )

// [1 Coverage] Companies with a value for female_workforce_pct: the count that decides whether a group figure built on it may be shown publicly (5 or more).
Companies with women in workforce =
    CALCULATE ( DISTINCTCOUNT ( fct_company_year[isin] ), NOT ISBLANK ( fct_company_year[female_workforce_pct] ) )

// [2 Intensity and shares (group)] tCO2e per Rs crore. Whole group: sum of ghg_s12_tco2e over sum of turnover_cr, over the companies that have both (semantic layer: ghg_intensity_agg). Large companies weigh more. Never an average of company ratios. Shown publicly only for 5 companies or more: check the matching 'Companies with ...' measure.
GHG intensity (whole group) =
    VAR rows_with_both =
        FILTER (
            fct_company_year,
            NOT ISBLANK ( fct_company_year[ghg_s12_tco2e] )
                && fct_company_year[turnover_cr] <> 0
        )
    RETURN
        DIVIDE (
            SUMX ( rows_with_both, fct_company_year[ghg_s12_tco2e] ),
            SUMX ( rows_with_both, fct_company_year[turnover_cr] )
        )

// [2 Intensity and shares (group)] GJ per Rs crore. Whole group: sum of energy_total_gj over sum of turnover_cr, over the companies that have both (semantic layer: energy_intensity_agg). Large companies weigh more. Never an average of company ratios. Shown publicly only for 5 companies or more: check the matching 'Companies with ...' measure.
Energy intensity (whole group) =
    VAR rows_with_both =
        FILTER (
            fct_company_year,
            NOT ISBLANK ( fct_company_year[energy_total_gj] )
                && fct_company_year[turnover_cr] <> 0
        )
    RETURN
        DIVIDE (
            SUMX ( rows_with_both, fct_company_year[energy_total_gj] ),
            SUMX ( rows_with_both, fct_company_year[turnover_cr] )
        )

// [2 Intensity and shares (group)] kl per Rs crore. Whole group: sum of water_consumption_kl over sum of turnover_cr, over the companies that have both (semantic layer: water_intensity_agg). Large companies weigh more. Never an average of company ratios. Shown publicly only for 5 companies or more: check the matching 'Companies with ...' measure.
Water intensity (whole group) =
    VAR rows_with_both =
        FILTER (
            fct_company_year,
            NOT ISBLANK ( fct_company_year[water_consumption_kl] )
                && fct_company_year[turnover_cr] <> 0
        )
    RETURN
        DIVIDE (
            SUMX ( rows_with_both, fct_company_year[water_consumption_kl] ),
            SUMX ( rows_with_both, fct_company_year[turnover_cr] )
        )

// [2 Intensity and shares (group)] t per Rs crore. Whole group: sum of waste_generated_t over sum of turnover_cr, over the companies that have both (semantic layer: waste_intensity_agg). Large companies weigh more. Never an average of company ratios. Shown publicly only for 5 companies or more: check the matching 'Companies with ...' measure.
Waste intensity (whole group) =
    VAR rows_with_both =
        FILTER (
            fct_company_year,
            NOT ISBLANK ( fct_company_year[waste_generated_t] )
                && fct_company_year[turnover_cr] <> 0
        )
    RETURN
        DIVIDE (
            SUMX ( rows_with_both, fct_company_year[waste_generated_t] ),
            SUMX ( rows_with_both, fct_company_year[turnover_cr] )
        )

// [2 Intensity and shares (group)] %. Whole group: sum of energy_renewable_gj over sum of energy_total_gj, over the companies that have both (semantic layer: renewable_share_agg). Large companies weigh more. Never an average of company ratios. Shown publicly only for 5 companies or more: check the matching 'Companies with ...' measure.
Renewable share (whole group, %) =
    VAR rows_with_both =
        FILTER (
            fct_company_year,
            NOT ISBLANK ( fct_company_year[energy_renewable_gj] )
                && fct_company_year[energy_total_gj] <> 0
        )
    RETURN
        100 * DIVIDE (
            SUMX ( rows_with_both, fct_company_year[energy_renewable_gj] ),
            SUMX ( rows_with_both, fct_company_year[energy_total_gj] )
        )

// [2 Intensity and shares (group)] %. Whole group: sum of headcount_female over sum of headcount_total, over the companies that have both (semantic layer: female_workforce_agg). Large companies weigh more. Never an average of company ratios. Shown publicly only for 5 companies or more: check the matching 'Companies with ...' measure.
Women in workforce (whole group, %) =
    VAR rows_with_both =
        FILTER (
            fct_company_year,
            NOT ISBLANK ( fct_company_year[headcount_female] )
                && fct_company_year[headcount_total] <> 0
        )
    RETURN
        100 * DIVIDE (
            SUMX ( rows_with_both, fct_company_year[headcount_female] ),
            SUMX ( rows_with_both, fct_company_year[headcount_total] )
        )

// [2 Intensity and shares (group)] tCO2e per Rs crore. Typical company: the median of ghg_intensity_tco2e_per_cr over the company-years in the selection (semantic layer: ghg_intensity_median). Every company weighs the same; use it within one year. Shown publicly only for 5 companies or more: check the matching 'Companies with ...' measure.
GHG intensity (typical company) =
    MEDIANX (
        FILTER ( fct_company_year, NOT ISBLANK ( fct_company_year[ghg_intensity_tco2e_per_cr] ) ),
        fct_company_year[ghg_intensity_tco2e_per_cr]
    )

// [2 Intensity and shares (group)] GJ per Rs crore. Typical company: the median of energy_intensity_gj_per_cr over the company-years in the selection (semantic layer: energy_intensity_median). Every company weighs the same; use it within one year. Shown publicly only for 5 companies or more: check the matching 'Companies with ...' measure.
Energy intensity (typical company) =
    MEDIANX (
        FILTER ( fct_company_year, NOT ISBLANK ( fct_company_year[energy_intensity_gj_per_cr] ) ),
        fct_company_year[energy_intensity_gj_per_cr]
    )

// [2 Intensity and shares (group)] kl per Rs crore. Typical company: the median of water_intensity_kl_per_cr over the company-years in the selection (semantic layer: water_intensity_median). Every company weighs the same; use it within one year. Shown publicly only for 5 companies or more: check the matching 'Companies with ...' measure.
Water intensity (typical company) =
    MEDIANX (
        FILTER ( fct_company_year, NOT ISBLANK ( fct_company_year[water_intensity_kl_per_cr] ) ),
        fct_company_year[water_intensity_kl_per_cr]
    )

// [2 Intensity and shares (group)] t per Rs crore. Typical company: the median of waste_intensity_t_per_cr over the company-years in the selection (semantic layer: waste_intensity_median). Every company weighs the same; use it within one year. Shown publicly only for 5 companies or more: check the matching 'Companies with ...' measure.
Waste intensity (typical company) =
    MEDIANX (
        FILTER ( fct_company_year, NOT ISBLANK ( fct_company_year[waste_intensity_t_per_cr] ) ),
        fct_company_year[waste_intensity_t_per_cr]
    )

// [2 Intensity and shares (group)] Company reports with a Scope 3 figure out of all reports, in % (semantic layer: scope3_disclosed_share). Shown publicly only for 5 companies or more: check the matching 'Companies with ...' measure.
Scope 3 disclosed (% of reports) =
    100
        * DIVIDE (
            COUNTROWS ( FILTER ( fct_company_year, fct_company_year[scope3_disclosed] = TRUE () ) ),
            COUNTROWS ( fct_company_year )
        )

// [3 Disclosure quality (group)] Average Disclosure Quality Score (semantic layer: dqs_avg). A score, not an intensity, so an average is allowed. Compare within one financial year only. Shown publicly only for 5 companies or more: check the matching 'Companies with ...' measure.
DQS average =
    AVERAGE ( fct_disclosure_quality[dqs_total] )

// [3 Disclosure quality (group)] Median Disclosure Quality Score (semantic layer: dqs_median). Compare within one financial year only. Shown publicly only for 5 companies or more: check the matching 'Companies with ...' measure.
DQS median =
    MEDIANX (
        FILTER ( fct_disclosure_quality, NOT ISBLANK ( fct_disclosure_quality[dqs_total] ) ),
        fct_disclosure_quality[dqs_total]
    )

// [3 Disclosure quality (group)] Graded company-years with grade A, in % (semantic layer: dqs_grade_a_share). Shown publicly only for 5 companies or more: check the matching 'Companies with ...' measure.
Grade A share (%) =
    100
        * DIVIDE (
            COUNTROWS ( FILTER ( fct_disclosure_quality, fct_disclosure_quality[dqs_grade] = "A" ) ),
            COUNTROWS (
                FILTER ( fct_disclosure_quality, NOT ISBLANK ( fct_disclosure_quality[dqs_grade] ) && fct_disclosure_quality[dqs_grade] <> "insufficient_data" )
            )
        )

// [3 Disclosure quality (group)] Average share (0-1) of Leadership indicators answered (semantic layer: voluntary_depth_avg). Shown publicly only for 5 companies or more: check the matching 'Companies with ...' measure.
Voluntary depth average =
    AVERAGE ( fct_disclosure_quality[dqs_voluntary_depth] )

// [1 Coverage] Companies with a Disclosure Quality Score (semantic layer: companies_with_dqs).
Companies with DQS =
    CALCULATE ( DISTINCTCOUNT ( fct_disclosure_quality[isin] ), NOT ISBLANK ( fct_disclosure_quality[dqs_total] ) )

// [1 Coverage] Companies with a grade A to D (semantic layer: companies_with_dqs_grade).
Companies with DQS grade =
    CALCULATE ( DISTINCTCOUNT ( fct_disclosure_quality[isin] ), fct_disclosure_quality[dqs_grade] IN { "A", "B", "C", "D" } )

// [4 Restatements (group)] Figures changed materially in the next year's report (semantic layer: material_restatements). Follows the year of the restated value. A restatement is not wrongdoing.
Material restatements =
    COUNTROWS ( FILTER ( fct_restatement, fct_restatement[classification] = "material" ) )

// [4 Restatements (group)] Compared figures restated materially, in % (semantic layer: material_restatement_share). Empty for the latest year: no later report yet. Shown publicly only for 5 companies or more: check the matching 'Companies with ...' measure.
Material restatement share (%) =
    100
        * DIVIDE (
            [Material restatements],
            COUNTROWS ( FILTER ( fct_restatement, fct_restatement[is_compared] = TRUE () ) )
        )

// [4 Restatements (group)] Figures more than 100 times apart between two reports: unit slips, not restatements (semantic layer: suspected_scale_errors).
Suspected scale errors =
    COUNTROWS ( FILTER ( fct_restatement, fct_restatement[classification] = "suspected_scale_error" ) )

// [1 Coverage] Companies with at least one figure compared with the next report (semantic layer: companies_with_compared_restatements).
Companies with compared restatements =
    CALCULATE ( DISTINCTCOUNT ( fct_restatement[isin] ), fct_restatement[is_compared] = TRUE () )

// [5 Data status and labels] Label for titles and tooltips: the latest year is provisional (its figures and scores can still change when the next reports arrive).
Year status =
    VAR selected_year = MAX ( dim_fiscal_year[fy_sort] )
    VAR latest_year = CALCULATE ( MAX ( dim_fiscal_year[fy_sort] ), ALL ( dim_fiscal_year ) )
    RETURN
        IF (
            NOT ISBLANK ( selected_year ),
            IF ( selected_year = latest_year, "Provisional: no later report yet", "Final" )
        )

// [5 Data status and labels] Text for a card or tooltip: a group of fewer than 5 companies gets no published statistic.
Public rule label =
    IF ( [Companies in selection] < 5, "n<5: would not be shown publicly", "" )

// [5 Data status and labels] Week 10 confidence label of a year-on-year GHG intensity change: confirmed, provisional, inferred_unit, restated_later, one_year_reversal or not_confirmed. Only confirmed changes are ranked.
Confidence of YoY change =
    SELECTEDVALUE ( q03_yoy_changes_with_confidence[confidence] )

// [6 Concentration (local only)] LOCAL ONLY: a total of filed values (tCO2e). Never show it in anything published; publish the shares below instead.
Scope 1+2 emissions (local only) =
    SUM ( fct_company_year[ghg_s12_tco2e] )

// [6 Concentration (local only)] A company's share of the Scope 1+2 emissions of all selected companies, in %.
Share of selected emissions (%) =
    100
        * DIVIDE (
            [Scope 1+2 emissions (local only)],
            CALCULATE ( [Scope 1+2 emissions (local only)], ALLSELECTED ( dim_company ) )
        )

// [6 Concentration (local only)] Pareto line: share of emissions held by this company and every larger emitter in the selection, in %. Use one year at a time.
Cumulative share of emissions (%) =
    VAR current_emissions = [Scope 1+2 emissions (local only)]
    VAR companies =
        ADDCOLUMNS (
            ALLSELECTED ( dim_company[display_name] ),
            "@emissions", [Scope 1+2 emissions (local only)]
        )
    RETURN
        IF (
            NOT ISBLANK ( current_emissions ),
            100
                * DIVIDE (
                    SUMX ( FILTER ( companies, [@emissions] >= current_emissions ), [@emissions] ),
                    SUMX ( companies, [@emissions] )
                )
        )

// [6 Concentration (local only)] 1 = largest emitter in the selection.
Emitter rank =
    IF (
        NOT ISBLANK ( [Scope 1+2 emissions (local only)] ),
        RANKX ( ALLSELECTED ( dim_company[display_name] ), [Scope 1+2 emissions (local only)], , DESC, DENSE )
    )

// [7 Company card] LOCAL ONLY for filed KPIs: the company's own value of the KPI on the row. Computed intensities are public; filed percentages are not.
Company value (local only) =
    SELECTEDVALUE ( fct_company_kpi_percentile[value] )

// [7 Company card] 0-100, 100 = best in the ranking group and year. Empty when the group has fewer than 5 companies with a value or the KPI is not material there (see 'Not ranked because').
Peer percentile =
    SELECTEDVALUE ( fct_company_kpi_percentile[percentile_in_group] )

// [7 Company card] Why there is no percentile: no_value, not_material, group_n_lt_5, flagged_value, no_direction.
Not ranked because =
    SELECTEDVALUE ( fct_company_kpi_percentile[percentile_null_reason] )

// [7 Company card] Median of the company's ranking group for the KPI on the row and the selected year (fct_peer_benchmark, only with 5 or more companies). MAX picks the one matching row.
Peer median (ranking group) =
    VAR kpi = SELECTEDVALUE ( fct_company_kpi_percentile[kpi_name] )
    VAR ranking_group = SELECTEDVALUE ( fct_company_kpi_percentile[ranking_group] )
    RETURN
        CALCULATE (
            MAX ( fct_peer_benchmark[median_value] ),
            fct_peer_benchmark[kpi_name] = kpi,
            fct_peer_benchmark[ranking_group] = ranking_group,
            fct_peer_benchmark[has_min_n] = TRUE ()
        )

// [7 Company card] The selected company's Disclosure Quality Score in the selected year.
Company DQS =
    SELECTEDVALUE ( fct_disclosure_quality[dqs_total] )

// [7 Company card] Percentile of the score within the ranking group and year (100 = best).
Company DQS percentile =
    SELECTEDVALUE ( fct_disclosure_quality[dqs_percentile_in_group] )

// [7 Company card] Provisional = the temporal check could not be run yet: the score can still fall.
Company DQS status =
    IF ( SELECTEDVALUE ( fct_disclosure_quality[is_provisional] ), "Provisional", "Final" )
