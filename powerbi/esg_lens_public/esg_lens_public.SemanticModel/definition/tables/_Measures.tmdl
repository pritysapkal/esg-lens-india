			RETURN
			    IF ( group_type = "ranking_group" && not_material > 0, "not ranked for this group (not material)" )
		displayFolder: 2 Intensity and shares (group)
		lineageTag: b787d4e0-82f1-5062-bc33-3bb61e901d68

	/// The published ghg_intensity_median of the selected company's ranking group and year (blank when withheld, n<5). MAX picks the one matching row.
	measure 'Peer median: GHG intensity' =
			VAR ranking_group = SELECTEDVALUE ( rpt_public_company_year[ranking_group] )
			VAR fiscal_year = SELECTEDVALUE ( rpt_public_company_year[fiscal_year_label] )
			RETURN
			    CALCULATE (
			        MAX ( rpt_public_group_metrics[ghg_intensity_median] ),
			        REMOVEFILTERS ( rpt_public_group_metrics ),
			        rpt_public_group_metrics[group_type] = "ranking_group",
			        rpt_public_group_metrics[group_value] = ranking_group,
			        rpt_public_group_metrics[fiscal_year_label] = fiscal_year
			    )
		formatString: #,##0.00
		displayFolder: 7 Company card
		lineageTag: 594f89ca-f80a-509f-8a94-347b097399be

	/// The published dqs_median of the selected company's ranking group and year (blank when withheld, n<5). MAX picks the one matching row.
	measure 'Peer median: DQS' =
			VAR ranking_group = SELECTEDVALUE ( rpt_public_company_year[ranking_group] )
			VAR fiscal_year = SELECTEDVALUE ( rpt_public_company_year[fiscal_year_label] )
			RETURN
			    CALCULATE (
			        MAX ( rpt_public_group_metrics[dqs_median] ),
			        REMOVEFILTERS ( rpt_public_group_metrics ),
			        rpt_public_group_metrics[group_type] = "ranking_group",
			        rpt_public_group_metrics[group_value] = ranking_group,
			        rpt_public_group_metrics[fiscal_year_label] = fiscal_year
			    )
		formatString: 0.0
		displayFolder: 7 Company card
		lineageTag: f4949da2-9881-556e-95bc-94af915ea2ee

	/// Keeps the measure table loadable.
	column Placeholder
		dataType: string
		isHidden
		lineageTag: 933b0dce-ca3b-57de-81ef-b28c7576245d
		summarizeBy: none
		sourceColumn: Placeholder

	partition _Measures = m
		mode: import
		source =
				let
				    Source = #table ( type table [Placeholder = text], {} )
				in
				    Source
