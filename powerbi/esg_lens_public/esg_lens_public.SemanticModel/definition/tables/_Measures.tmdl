/// All measures, in display folders. Group figures mirror the semantic layer.
table _Measures
	lineageTag: 28d3f736-db23-5871-a4fe-a4f667adfc90

	/// Companies with a report in the current selection.
	measure 'Companies in selection' =
			DISTINCTCOUNT ( rpt_public_company_year[isin] )
		formatString: 0
		displayFolder: 1 Coverage
		lineageTag: 85fd57ef-61dd-5c6d-95b9-05f6bbe4e07a

	/// The group figures show a value only when exactly one row of rpt_public_group_metrics is selected: one group type, one group, one year.
	measure 'Group rows in selection' =
			COUNTROWS ( rpt_public_group_metrics )
		formatString: 0
		displayFolder: 5 Data status and labels
		lineageTag: abb80dec-21ff-585d-8a87-dd17951d2609

	/// Why a group figure is empty: fewer than 5 companies (n<5), or a restatement figure of a year with no later report.
	measure 'Withheld note' =
			VAR reason = IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[suppressed_reason] ) )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( reason ), BLANK (),
			        CONTAINSSTRING ( reason, "fewer_than_5" ) && CONTAINSSTRING ( reason, "not_yet" ),
			            "n<5; restatements not yet observable",
			        CONTAINSSTRING ( reason, "fewer_than_5" ), "n<5: fewer than 5 companies",
			        "Restatements not yet observable: no later report"
			    )
		displayFolder: 5 Data status and labels
		lineageTag: d5ca809c-1f3c-5deb-85d1-85c60ab3a779

	/// Provisional year = FY2025-26, the latest year: no later report has confirmed its figures yet. Blank unless one year is selected.
	measure 'Year status' =
			VAR y = SELECTEDVALUE ( dim_fiscal_year[fiscal_year_label] )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( y ), BLANK (),
			        y = "FY2025-26", "Provisional year",
			        "Confirmed year"
			    )
		displayFolder: 5 Data status and labels
		lineageTag: e1c8840c-7d05-5196-89cf-a536b8f45a55

	/// tCO2e per Rs crore. All the Scope 1+2 emissions of the group divided by all its turnover: the intensity of the group as if it were one company. Large companies weigh more. Published value from rpt_public_group_metrics.ghg_intensity_agg; shown only when one group, one group type and one year are selected. Blank when withheld: see 'Withheld note'.
	measure 'GHG intensity, whole group' =
			IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[ghg_intensity_agg] ) )
		formatString: #,##0.00
		displayFolder: 2 Intensity and shares (group)
		lineageTag: d0d7642e-eab8-5524-acb7-5ef2b2c94b34

	/// tCO2e per Rs crore. The intensity of the company in the middle of the group: half the companies are below it, half above. Every company weighs the same. Published value from rpt_public_group_metrics.ghg_intensity_median; shown only when one group, one group type and one year are selected. Blank when withheld: see 'Withheld note'.
	measure 'GHG intensity, typical company' =
			IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[ghg_intensity_median] ) )
		formatString: #,##0.00
		displayFolder: 2 Intensity and shares (group)
		lineageTag: 9589fc37-6387-57df-b7e9-575ed61e6261

	/// companies. How many companies of the group have a ghg intensity. The whole-group and typical-company figures may be published only when this is 5 or more. Published value from rpt_public_group_metrics.companies_with_ghg_intensity; shown only when one group, one group type and one year are selected.
	measure 'Companies with a ghg intensity' =
			IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[companies_with_ghg_intensity] ) )
		formatString: 0
		displayFolder: 1 Coverage
		lineageTag: 116aa9c9-d8b9-5330-8236-c0f9fe06bcc3

	/// GJ per Rs crore. All the energy used of the group divided by all its turnover: the intensity of the group as if it were one company. Large companies weigh more. Published value from rpt_public_group_metrics.energy_intensity_agg; shown only when one group, one group type and one year are selected. Blank when withheld: see 'Withheld note'.
	measure 'Energy intensity, whole group' =
			IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[energy_intensity_agg] ) )
		formatString: #,##0.00
		displayFolder: 2 Intensity and shares (group)
		lineageTag: 2f11710b-68fb-5e46-9676-f9eddc783877

	/// GJ per Rs crore. The intensity of the company in the middle of the group: half the companies are below it, half above. Every company weighs the same. Published value from rpt_public_group_metrics.energy_intensity_median; shown only when one group, one group type and one year are selected. Blank when withheld: see 'Withheld note'.
	measure 'Energy intensity, typical company' =
			IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[energy_intensity_median] ) )
		formatString: #,##0.00
		displayFolder: 2 Intensity and shares (group)
		lineageTag: b25eb486-c2cf-56a4-93a8-bad749403d7b

	/// companies. How many companies of the group have a energy intensity. The whole-group and typical-company figures may be published only when this is 5 or more. Published value from rpt_public_group_metrics.companies_with_energy_intensity; shown only when one group, one group type and one year are selected.
	measure 'Companies with a energy intensity' =
			IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[companies_with_energy_intensity] ) )
		formatString: 0
		displayFolder: 1 Coverage
		lineageTag: b078d046-6456-5f9b-8769-1ef0f14511dd

	/// kl per Rs crore. All the water consumed of the group divided by all its turnover: the intensity of the group as if it were one company. Large companies weigh more. Published value from rpt_public_group_metrics.water_intensity_agg; shown only when one group, one group type and one year are selected. Blank when withheld: see 'Withheld note'.
	measure 'Water intensity, whole group' =
			IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[water_intensity_agg] ) )
		formatString: #,##0.00
		displayFolder: 2 Intensity and shares (group)
		lineageTag: 5ea1f102-03e4-505c-87cb-1814109789ea

	/// kl per Rs crore. The intensity of the company in the middle of the group: half the companies are below it, half above. Every company weighs the same. Published value from rpt_public_group_metrics.water_intensity_median; shown only when one group, one group type and one year are selected. Blank when withheld: see 'Withheld note'.
	measure 'Water intensity, typical company' =
			IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[water_intensity_median] ) )
		formatString: #,##0.00
		displayFolder: 2 Intensity and shares (group)
		lineageTag: 02e9e06f-a131-5bd3-827e-1d278fc8e5d9

	/// companies. How many companies of the group have a water intensity. The whole-group and typical-company figures may be published only when this is 5 or more. Published value from rpt_public_group_metrics.companies_with_water_intensity; shown only when one group, one group type and one year are selected.
	measure 'Companies with a water intensity' =
			IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[companies_with_water_intensity] ) )
		formatString: 0
		displayFolder: 1 Coverage
		lineageTag: d39ea03a-91ed-561c-9bf5-18b065f28752

	/// t per Rs crore. All the waste generated of the group divided by all its turnover: the intensity of the group as if it were one company. Large companies weigh more. Published value from rpt_public_group_metrics.waste_intensity_agg; shown only when one group, one group type and one year are selected. Blank when withheld: see 'Withheld note'.
	measure 'Waste intensity, whole group' =
			IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[waste_intensity_agg] ) )
		formatString: #,##0.00
		displayFolder: 2 Intensity and shares (group)
		lineageTag: f678c664-14d2-579c-9adc-5cd4ce42b859

	/// t per Rs crore. The intensity of the company in the middle of the group: half the companies are below it, half above. Every company weighs the same. Published value from rpt_public_group_metrics.waste_intensity_median; shown only when one group, one group type and one year are selected. Blank when withheld: see 'Withheld note'.
	measure 'Waste intensity, typical company' =
			IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[waste_intensity_median] ) )
		formatString: #,##0.00
		displayFolder: 2 Intensity and shares (group)
		lineageTag: e1b7e6f9-ff39-5357-b5ae-d515e17884d4

	/// companies. How many companies of the group have a waste intensity. The whole-group and typical-company figures may be published only when this is 5 or more. Published value from rpt_public_group_metrics.companies_with_waste_intensity; shown only when one group, one group type and one year are selected.
	measure 'Companies with a waste intensity' =
			IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[companies_with_waste_intensity] ) )
		formatString: 0
		displayFolder: 1 Coverage
		lineageTag: ee20e122-6389-5ac4-9b05-5444af0c3505

	/// %. Out of all the energy the group used, the percentage that was renewable. Large energy users weigh more. Published value from rpt_public_group_metrics.renewable_share_agg; shown only when one group, one group type and one year are selected. Blank when withheld: see 'Withheld note'.
	measure 'Renewable share of energy, whole group (%)' =
			IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[renewable_share_agg] ) )
		formatString: 0.0
		displayFolder: 2 Intensity and shares (group)
		lineageTag: 900e321a-03c4-5871-b9f9-2226bc620c22

	/// companies. How many companies of the group have a renewable share. The whole-group figure may be published only when this is 5 or more. Published value from rpt_public_group_metrics.companies_with_renewable_share; shown only when one group, one group type and one year are selected.
	measure 'Companies with a renewable share' =
			IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[companies_with_renewable_share] ) )
		formatString: 0
		displayFolder: 1 Coverage
		lineageTag: 4e36ed52-7fc4-5859-bd2c-d16746db2902

	/// %. Out of everyone working for the companies of the group, the percentage who are women. Large employers weigh more. Published value from rpt_public_group_metrics.female_workforce_agg; shown only when one group, one group type and one year are selected. Blank when withheld: see 'Withheld note'.
	measure 'Women in workforce, whole group (%)' =
			IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[female_workforce_agg] ) )
		formatString: 0.0
		displayFolder: 2 Intensity and shares (group)
		lineageTag: 9339e2f7-5252-526c-b9b2-5b513f833885

	/// companies. How many companies of the group have a women-in-workforce share. The whole-group figure may be published only when this is 5 or more. Published value from rpt_public_group_metrics.companies_with_female_workforce; shown only when one group, one group type and one year are selected.
	measure 'Companies with a women-in-workforce share' =
			IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[companies_with_female_workforce] ) )
		formatString: 0
		displayFolder: 1 Coverage
		lineageTag: fbf69cf9-99b4-5362-b826-bfa7b3f28c4c

	/// companies. How many companies have a report in the group and year. Published value from rpt_public_group_metrics.companies_reporting; shown only when one group, one group type and one year are selected.
	measure 'Companies reporting' =
			IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[companies_reporting] ) )
		formatString: 0
		displayFolder: 1 Coverage
		lineageTag: 3770e208-995f-50a6-9321-7161f02c14ef

	/// %. Out of every 100 company reports, how many give a Scope 3 emissions figure. Published value from rpt_public_group_metrics.scope3_disclosed_share; shown only when one group, one group type and one year are selected. Blank when withheld: see 'Withheld note'.
	measure 'Companies disclosing Scope 3 (%)' =
			IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[scope3_disclosed_share] ) )
		formatString: 0.0
		displayFolder: 2 Intensity and shares (group)
		lineageTag: 61f10d1e-976e-579b-8423-00ae18161de5

	/// points (0-100). The average Disclosure Quality Score of the group. Compare within one financial year only. Published value from rpt_public_group_metrics.dqs_avg; shown only when one group, one group type and one year are selected. Blank when withheld: see 'Withheld note'.
	measure 'Disclosure Quality Score, average' =
			IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[dqs_avg] ) )
		formatString: 0.0
		displayFolder: 3 Disclosure quality (group)
		lineageTag: da1c4b35-e1e7-512f-8c5b-852b5ac49efd

	/// points (0-100). The Disclosure Quality Score of the company in the middle of the group. Published value from rpt_public_group_metrics.dqs_median; shown only when one group, one group type and one year are selected. Blank when withheld: see 'Withheld note'.
	measure 'Disclosure Quality Score, typical company' =
			IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[dqs_median] ) )
		formatString: 0.0
		displayFolder: 3 Disclosure quality (group)
		lineageTag: 92f903b7-2f9c-5371-883a-ec26da9f0898

	/// %. Out of every 100 graded company reports, how many reach grade A (85 points or more). Published value from rpt_public_group_metrics.dqs_grade_a_share; shown only when one group, one group type and one year are selected. Blank when withheld: see 'Withheld note'.
	measure 'Company-years graded A (%)' =
			IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[dqs_grade_a_share] ) )
		formatString: 0.0
		displayFolder: 3 Disclosure quality (group)
		lineageTag: 19d43db1-d1d5-570a-acba-df1195771ba3

	/// share (0-1). On average, the share of the voluntary (Leadership) indicators that the companies of the group answered. Published value from rpt_public_group_metrics.voluntary_depth_avg; shown only when one group, one group type and one year are selected. Blank when withheld: see 'Withheld note'.
	measure 'Voluntary depth, average' =
			IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[voluntary_depth_avg] ) )
		formatString: #,##0.00
		displayFolder: 3 Disclosure quality (group)
		lineageTag: 6797bd0d-4ced-59c4-b92c-92e216c017ff

	/// companies. How many companies of the group have a Disclosure Quality Score. Published value from rpt_public_group_metrics.companies_with_dqs; shown only when one group, one group type and one year are selected.
	measure 'Companies with a Disclosure Quality Score' =
			IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[companies_with_dqs] ) )
		formatString: 0
		displayFolder: 1 Coverage
		lineageTag: abfe6a18-7a74-5f4c-aa53-12252a06734c

	/// companies. How many companies of the group have a grade (at least three components scored). Published value from rpt_public_group_metrics.companies_with_dqs_grade; shown only when one group, one group type and one year are selected.
	measure 'Companies with a Disclosure Quality grade' =
			IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[companies_with_dqs_grade] ) )
		formatString: 0
		displayFolder: 1 Coverage
		lineageTag: 7a0f1a72-f583-521f-827a-40a93f0778a0

	/// companies. How many companies of the group have a voluntary depth figure. Published value from rpt_public_group_metrics.companies_with_voluntary_depth; shown only when one group, one group type and one year are selected.
	measure 'Companies with a voluntary depth' =
			IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[companies_with_voluntary_depth] ) )
		formatString: 0
		displayFolder: 1 Coverage
		lineageTag: 822be261-2391-5548-aa17-0aecd82a9b0e

	/// restated values. How many figures were changed materially in the next year's report. A restatement is not wrongdoing. Published value from rpt_public_group_metrics.material_restatements; shown only when one group, one group type and one year are selected.
	measure 'Material restatements' =
			IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[material_restatements] ) )
		formatString: 0
		displayFolder: 1 Coverage
		lineageTag: 3e2f0be7-85cc-56c6-932d-fdbd403f4499

	/// %. Out of every 100 figures that could be compared with the next year's report, how many were changed materially. Published value from rpt_public_group_metrics.material_restatement_share; shown only when one group, one group type and one year are selected. Blank when withheld: see 'Withheld note'.
	measure 'Figures materially restated (%)' =
			IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[material_restatement_share] ) )
		formatString: 0.0
		displayFolder: 4 Restatements (group)
		lineageTag: aac499c8-9e88-5844-9223-1ad80103212a

	/// values. How many figures are more than 100 times apart from the next year's report: unit slips, not restatements. Published value from rpt_public_group_metrics.suspected_scale_errors; shown only when one group, one group type and one year are selected.
	measure 'Suspected scale errors' =
			IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[suspected_scale_errors] ) )
		formatString: 0
		displayFolder: 1 Coverage
		lineageTag: 33251c39-4482-50bf-8bd1-780473e9ed58

	/// companies. How many companies of the group have at least one figure that could be compared with the next year's report. Published value from rpt_public_group_metrics.companies_with_compared_restatements; shown only when one group, one group type and one year are selected.
	measure 'Companies with compared figures' =
			IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[companies_with_compared_restatements] ) )
		formatString: 0
		displayFolder: 1 Coverage
		lineageTag: 4a7c7c4d-7e62-5416-a014-678d51e9c041

	/// The selected company's ghg_intensity_tco2e_per_cr in the selected year (computed by ESG Lens India; public).
	measure 'Company: GHG intensity' =
			SELECTEDVALUE ( rpt_public_company_year[ghg_intensity_tco2e_per_cr] )
		formatString: #,##0.00
		displayFolder: 7 Company card
		lineageTag: e87948fa-8d2f-51bd-b566-9b072f46361a

	/// The selected company's energy_intensity_gj_per_cr in the selected year (computed by ESG Lens India; public).
	measure 'Company: energy intensity' =
			SELECTEDVALUE ( rpt_public_company_year[energy_intensity_gj_per_cr] )
		formatString: #,##0.0
		displayFolder: 7 Company card
		lineageTag: 80cf5e08-03c7-5b3d-a5e1-c7eac44ee37c

	/// The selected company's water_intensity_kl_per_cr in the selected year (computed by ESG Lens India; public).
	measure 'Company: water intensity' =
			SELECTEDVALUE ( rpt_public_company_year[water_intensity_kl_per_cr] )
		formatString: #,##0.0
		displayFolder: 7 Company card
		lineageTag: 98592da2-45a9-5e26-804e-628ab624d0a8

	/// The selected company's waste_intensity_t_per_cr in the selected year (computed by ESG Lens India; public).
	measure 'Company: waste intensity' =
			SELECTEDVALUE ( rpt_public_company_year[waste_intensity_t_per_cr] )
		formatString: #,##0.00
		displayFolder: 7 Company card
		lineageTag: fc696294-e0e2-51cf-833e-5a19e56e82f7

	/// The selected company's renewable_share_pct in the selected year (computed by ESG Lens India; public).
	measure 'Company: renewable share (%)' =
			SELECTEDVALUE ( rpt_public_company_year[renewable_share_pct] )
		formatString: 0.0
		displayFolder: 7 Company card
		lineageTag: 8e663219-b3eb-56e1-ad62-9d27af31a155

	/// The selected company's female_workforce_pct in the selected year (computed by ESG Lens India; public).
	measure 'Company: women in workforce (%)' =
			SELECTEDVALUE ( rpt_public_company_year[female_workforce_pct] )
		formatString: 0.0
		displayFolder: 7 Company card
		lineageTag: fefee67a-d4a0-5df5-a02b-d71f6e9966ab

	/// The selected company's pay_equity_gap_pp in the selected year (computed by ESG Lens India; public).
	measure 'Company: pay-equity gap (pp)' =
			SELECTEDVALUE ( rpt_public_company_year[pay_equity_gap_pp] )
		formatString: +0.0;-0.0;0.0
		displayFolder: 7 Company card
		lineageTag: ffae1a1f-1de4-5972-a9c8-69f066f7339e

	/// The selected company's dqs_total in the selected year.
	measure 'Company: DQS' =
			SELECTEDVALUE ( rpt_public_disclosure_quality[dqs_total] )
		formatString: 0.0
		displayFolder: 7 Company card
		lineageTag: c30415c3-d37c-522c-b08a-991b40359361

	/// The selected company's dqs_grade in the selected year.
	measure 'Company: DQS grade' =
			SELECTEDVALUE ( rpt_public_disclosure_quality[dqs_grade] )
		displayFolder: 7 Company card
		lineageTag: ecfa9bc2-0392-5b0f-a412-6a8aa2fea8a4

	/// The selected company's dqs_rank_in_group in the selected year.
	measure 'Company: DQS rank in group' =
			SELECTEDVALUE ( rpt_public_disclosure_quality[dqs_rank_in_group] )
		formatString: 0
		displayFolder: 7 Company card
		lineageTag: a781cbfe-7649-5901-b072-5d1bca251057

	/// The selected company's dqs_percentile_in_group in the selected year.
	measure 'Company: DQS percentile in group' =
			SELECTEDVALUE ( rpt_public_disclosure_quality[dqs_percentile_in_group] )
		formatString: 0.0
		displayFolder: 7 Company card
		lineageTag: 99b5eec3-14f8-57e5-beac-ae2a1cb6e44a

	/// Provisional = the latest year: no later report has confirmed the figures yet.
	measure 'Company: data status' =
			IF ( SELECTEDVALUE ( rpt_public_disclosure_quality[is_provisional] ), "Provisional", "Final" )
		displayFolder: 7 Company card
		lineageTag: e26c0cfa-ffe0-5b51-86c0-79baa6815813

	/// 1 = largest Scope 1+2 emitter of the year among all companies covered.
	measure 'Emitter rank' =
			SELECTEDVALUE ( rpt_public_concentration[emitter_rank] )
		formatString: 0
		displayFolder: 6 Concentration (shares)
		lineageTag: 24329a79-92ff-5f3f-a19e-aa06659afb17

	/// The company's share of the Scope 1+2 emissions of all companies covered that year, in %. Use with dim_company[display_name] on the axis and one year selected.
	measure 'Share of total emissions (%)' =
			SELECTEDVALUE ( rpt_public_concentration[share_of_total_pct] )
		formatString: 0.0
		displayFolder: 6 Concentration (shares)
		lineageTag: bd76c578-da2b-5071-8d48-c2953bf75855

	/// Share held by this company and every larger emitter together, in %: the Pareto line.
	measure 'Cumulative share of emissions (%)' =
			SELECTEDVALUE ( rpt_public_concentration[cumulative_share_pct] )
		formatString: 0.0
		displayFolder: 6 Concentration (shares)
		lineageTag: 363079ba-5f6b-5023-a3af-05c2b2c16b9c

	/// Share of the year's Scope 1+2 emissions held by the 5 largest emitters, in %. Select one year; company and group slicers are ignored on purpose (the share is of all companies covered).
	measure 'Top-5 share of emissions (%)' =
			CALCULATE (
			    SELECTEDVALUE ( rpt_public_concentration[cumulative_share_pct] ),
			    rpt_public_concentration[emitter_rank] = 5,
			    REMOVEFILTERS ( dim_company )
			)
		formatString: 0.0
		displayFolder: 6 Concentration (shares)
		lineageTag: 5b13e915-9914-5134-b157-7a63ad655307

	/// Share of the year's Scope 1+2 emissions held by the 10 largest emitters, in %. Select one year; company and group slicers are ignored on purpose (the share is of all companies covered).
	measure 'Top-10 share of emissions (%)' =
			CALCULATE (
			    SELECTEDVALUE ( rpt_public_concentration[cumulative_share_pct] ),
			    rpt_public_concentration[emitter_rank] = 10,
			    REMOVEFILTERS ( dim_company )
			)
		formatString: 0.0
		displayFolder: 6 Concentration (shares)
		lineageTag: 3ba0bc40-29c5-5eb6-95c7-ebe967501aac

	/// How many of the largest emitters it takes to reach 80% of the year's Scope 1+2 emissions. Select one year.
	measure 'Companies for 80% of emissions' =
			VAR below_80 =
			    CALCULATE (
			        COUNTROWS ( rpt_public_concentration ),
			        rpt_public_concentration[cumulative_share_pct] < 80,
			        REMOVEFILTERS ( dim_company )
			    )
			RETURN
			    IF ( HASONEVALUE ( dim_fiscal_year[fiscal_year_label] ), below_80 + 1 )
		formatString: 0
		displayFolder: 6 Concentration (shares)
		lineageTag: 2b788862-b09b-5969-b263-2e385d493b96

	/// Percentile in the ranking group for the KPI on the row (100 = best). Put kpi_label on the rows of a table and select one company and year.
	measure 'Company: peer percentile' =
			SELECTEDVALUE ( rpt_public_company_percentile[percentile_in_group] )
		formatString: 0.0
		displayFolder: 7 Company card
		lineageTag: be255923-ef32-5ab3-8531-201493b7c4b1

	/// Rank in the ranking group for the KPI on the row (1 = best).
	measure 'Company: rank in group' =
			SELECTEDVALUE ( rpt_public_company_percentile[rank_in_group] )
		formatString: 0
		displayFolder: 7 Company card
		lineageTag: 3f7640e4-45c0-5256-a2b3-7085ff0af3cc

	/// Companies of the ranking group with a value of the KPI: the base of the rank. Below 5 there is no rank.
	measure 'Company: companies in group' =
			SELECTEDVALUE ( rpt_public_company_percentile[n_in_group] )
		formatString: 0
		displayFolder: 7 Company card
		lineageTag: ed0d6d07-13d2-5d6d-8c00-8ed0a93dce16

	/// The company's value of the KPI on the row, only for KPIs we compute (empty for filed values).
	measure 'Company: KPI value (public KPIs)' =
			SELECTEDVALUE ( rpt_public_company_percentile[kpi_value_public] )
		formatString: #,##0.00
		displayFolder: 7 Company card
		lineageTag: 6d7c22f9-be31-5361-9004-3d90af715995

	/// Why the KPI on the row has a rank or not. A KPI that is not material for the ranking group is not ranked, although its group median is still shown as a description.
	measure 'Company: ranking status' =
			VAR ranked = SELECTEDVALUE ( rpt_public_company_percentile[is_ranked] )
			VAR reason = SELECTEDVALUE ( rpt_public_company_percentile[reason_not_ranked] )
			RETURN
			    SWITCH (
			        TRUE (),
			        ranked = TRUE (), "ranked",
			        reason = "not_material", "not ranked for this group (not material)",
			        reason = "group_n_lt_5", "not ranked: fewer than 5 companies (n<5)",
			        reason = "flagged_value", "not ranked: value flagged",
			        reason = "no_direction", "not ranked: no better or worse direction",
			        BLANK ()
			    )
		displayFolder: 7 Company card
		lineageTag: d846eba1-bebf-5de6-aa06-1433b03cee19

	/// Label for a ranking group's GHG intensity median: companies are not ranked on it in this group because the KPI is not material there (for example GHG intensity for Financials). The median is still shown, as a description of the group.
	measure 'Ranking note: GHG intensity' =
			VAR group_type = SELECTEDVALUE ( rpt_public_group_metrics[group_type] )
			VAR ranking_group = SELECTEDVALUE ( rpt_public_group_metrics[group_value] )
			VAR fiscal_year = SELECTEDVALUE ( rpt_public_group_metrics[fiscal_year_label] )
			VAR not_material =
			    CALCULATE (
			        COUNTROWS ( rpt_public_company_percentile ),
			        REMOVEFILTERS ( rpt_public_company_percentile ),
			        rpt_public_company_percentile[ranking_group] = ranking_group,
			        rpt_public_company_percentile[fiscal_year_label] = fiscal_year,
			        rpt_public_company_percentile[kpi_name] = "ghg_intensity_tco2e_per_cr",
			        rpt_public_company_percentile[reason_not_ranked] = "not_material"
			    )
			RETURN
			    IF ( group_type = "ranking_group" && not_material > 0, "not ranked for this group (not material)" )
		displayFolder: 2 Intensity and shares (group)
		lineageTag: f8aa79cd-1ea0-5165-a499-cfe0ebf7d43f

	/// Label for a ranking group's energy intensity median: companies are not ranked on it in this group because the KPI is not material there (for example GHG intensity for Financials). The median is still shown, as a description of the group.
	measure 'Ranking note: energy intensity' =
			VAR group_type = SELECTEDVALUE ( rpt_public_group_metrics[group_type] )
			VAR ranking_group = SELECTEDVALUE ( rpt_public_group_metrics[group_value] )
			VAR fiscal_year = SELECTEDVALUE ( rpt_public_group_metrics[fiscal_year_label] )
