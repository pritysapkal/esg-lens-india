			        rpt_public_company_percentile[fiscal_year_label] = fiscal_year,
			        rpt_public_company_percentile[kpi_name] = "energy_intensity_gj_per_cr",
			        rpt_public_company_percentile[reason_not_ranked] = "not_material"
			    )
			RETURN
			    IF ( group_type = "ranking_group" && not_material > 0, "not ranked for this group (not material)" )
		displayFolder: 2 Intensity and shares (group)
		lineageTag: 1c4d3b9b-6423-5ab7-93ef-56c796e3c090

	/// Label for a ranking group's water intensity median: companies are not ranked on it in this group because the KPI is not material there (for example GHG intensity for Financials). The median is still shown, as a description of the group.
	measure 'Ranking note: water intensity' =
