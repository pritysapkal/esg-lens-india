	/// Label for a ranking group's waste intensity median: companies are not ranked on it in this group because the KPI is not material there (for example GHG intensity for Financials). The median is still shown, as a description of the group.
	measure 'Ranking note: waste intensity' =
			VAR group_type = SELECTEDVALUE ( rpt_public_group_metrics[group_type] )
			VAR ranking_group = SELECTEDVALUE ( rpt_public_group_metrics[group_value] )
			VAR fiscal_year = SELECTEDVALUE ( rpt_public_group_metrics[fiscal_year_label] )
