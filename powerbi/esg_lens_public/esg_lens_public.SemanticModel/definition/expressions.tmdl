/// Folder that holds the exported Parquet files (exports\public). Set it once in
/// Power BI Desktop: Transform data > Edit parameters. Do not commit your own path.
expression ExportFolder = "SET-ME: full path of the exports\public folder, no backslash at the end" meta [IsParameterQuery = true, Type = "Text", IsParameterQueryRequired = true]
	lineageTag: cdb27274-3e35-53c1-b4c5-120a4f8706a9

	annotation PBI_ResultType = Text
