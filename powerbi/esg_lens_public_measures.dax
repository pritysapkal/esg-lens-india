// ESG Lens India - measures of the public model.
// Generated by scripts/build_powerbi.py; paste one at a time into New measure.

// [1 Coverage] Companies with a report in the current selection.
Companies in selection =
    DISTINCTCOUNT ( rpt_public_company_year[isin] )

// [5 Data status and labels] The group figures show a value only when exactly one row of rpt_public_group_metrics is selected: one group type, one group, one year.
Group rows in selection =
    COUNTROWS ( rpt_public_group_metrics )

// [5 Data status and labels] Why a group figure is empty: fewer than 5 companies (n<5), or a restatement figure of a year with no later report.
Withheld note =
    VAR reason = IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[suppressed_reason] ) )
    RETURN
        SWITCH (
            TRUE (),
            ISBLANK ( reason ), BLANK (),
            CONTAINSSTRING ( reason, "fewer_than_5" ) && CONTAINSSTRING ( reason, "not_yet" ),
                "n<5; restatements not yet observable",
            CONTAINSSTRING ( reason, "fewer_than_5" ), "n<5: fewer than 5 companies",
            "Restatements not yet observable: no later report"
        )

// [2 Intensity and shares (group)] tCO2e per Rs crore. All the Scope 1+2 emissions of the group divided by all its turnover: the intensity of the group as if it were one company. Large companies weigh more. Published value from rpt_public_group_metrics.ghg_intensity_agg; shown only when one group, one group type and one year are selected. Blank when withheld: see 'Withheld note'.
GHG intensity, whole group =
    IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[ghg_intensity_agg] ) )

// [2 Intensity and shares (group)] tCO2e per Rs crore. The intensity of the company in the middle of the group: half the companies are below it, half above. Every company weighs the same. Published value from rpt_public_group_metrics.ghg_intensity_median; shown only when one group, one group type and one year are selected. Blank when withheld: see 'Withheld note'.
GHG intensity, typical company =
    IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[ghg_intensity_median] ) )

// [1 Coverage] companies. How many companies of the group have a ghg intensity. The whole-group and typical-company figures may be published only when this is 5 or more. Published value from rpt_public_group_metrics.companies_with_ghg_intensity; shown only when one group, one group type and one year are selected.
Companies with a ghg intensity =
    IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[companies_with_ghg_intensity] ) )

// [2 Intensity and shares (group)] GJ per Rs crore. All the energy used of the group divided by all its turnover: the intensity of the group as if it were one company. Large companies weigh more. Published value from rpt_public_group_metrics.energy_intensity_agg; shown only when one group, one group type and one year are selected. Blank when withheld: see 'Withheld note'.
Energy intensity, whole group =
    IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[energy_intensity_agg] ) )

// [2 Intensity and shares (group)] GJ per Rs crore. The intensity of the company in the middle of the group: half the companies are below it, half above. Every company weighs the same. Published value from rpt_public_group_metrics.energy_intensity_median; shown only when one group, one group type and one year are selected. Blank when withheld: see 'Withheld note'.
Energy intensity, typical company =
    IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[energy_intensity_median] ) )

// [1 Coverage] companies. How many companies of the group have a energy intensity. The whole-group and typical-company figures may be published only when this is 5 or more. Published value from rpt_public_group_metrics.companies_with_energy_intensity; shown only when one group, one group type and one year are selected.
Companies with a energy intensity =
    IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[companies_with_energy_intensity] ) )

// [2 Intensity and shares (group)] kl per Rs crore. All the water consumed of the group divided by all its turnover: the intensity of the group as if it were one company. Large companies weigh more. Published value from rpt_public_group_metrics.water_intensity_agg; shown only when one group, one group type and one year are selected. Blank when withheld: see 'Withheld note'.
Water intensity, whole group =
    IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[water_intensity_agg] ) )

// [2 Intensity and shares (group)] kl per Rs crore. The intensity of the company in the middle of the group: half the companies are below it, half above. Every company weighs the same. Published value from rpt_public_group_metrics.water_intensity_median; shown only when one group, one group type and one year are selected. Blank when withheld: see 'Withheld note'.
Water intensity, typical company =
    IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[water_intensity_median] ) )

// [1 Coverage] companies. How many companies of the group have a water intensity. The whole-group and typical-company figures may be published only when this is 5 or more. Published value from rpt_public_group_metrics.companies_with_water_intensity; shown only when one group, one group type and one year are selected.
Companies with a water intensity =
    IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[companies_with_water_intensity] ) )

// [2 Intensity and shares (group)] t per Rs crore. All the waste generated of the group divided by all its turnover: the intensity of the group as if it were one company. Large companies weigh more. Published value from rpt_public_group_metrics.waste_intensity_agg; shown only when one group, one group type and one year are selected. Blank when withheld: see 'Withheld note'.
Waste intensity, whole group =
    IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[waste_intensity_agg] ) )

// [2 Intensity and shares (group)] t per Rs crore. The intensity of the company in the middle of the group: half the companies are below it, half above. Every company weighs the same. Published value from rpt_public_group_metrics.waste_intensity_median; shown only when one group, one group type and one year are selected. Blank when withheld: see 'Withheld note'.
Waste intensity, typical company =
    IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[waste_intensity_median] ) )

// [1 Coverage] companies. How many companies of the group have a waste intensity. The whole-group and typical-company figures may be published only when this is 5 or more. Published value from rpt_public_group_metrics.companies_with_waste_intensity; shown only when one group, one group type and one year are selected.
Companies with a waste intensity =
    IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[companies_with_waste_intensity] ) )

// [2 Intensity and shares (group)] %. Out of all the energy the group used, the percentage that was renewable. Large energy users weigh more. Published value from rpt_public_group_metrics.renewable_share_agg; shown only when one group, one group type and one year are selected. Blank when withheld: see 'Withheld note'.
Renewable share of energy, whole group (%) =
    IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[renewable_share_agg] ) )

// [1 Coverage] companies. How many companies of the group have a renewable share. The whole-group figure may be published only when this is 5 or more. Published value from rpt_public_group_metrics.companies_with_renewable_share; shown only when one group, one group type and one year are selected.
Companies with a renewable share =
    IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[companies_with_renewable_share] ) )

// [2 Intensity and shares (group)] %. Out of everyone working for the companies of the group, the percentage who are women. Large employers weigh more. Published value from rpt_public_group_metrics.female_workforce_agg; shown only when one group, one group type and one year are selected. Blank when withheld: see 'Withheld note'.
Women in workforce, whole group (%) =
    IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[female_workforce_agg] ) )

// [1 Coverage] companies. How many companies of the group have a women-in-workforce share. The whole-group figure may be published only when this is 5 or more. Published value from rpt_public_group_metrics.companies_with_female_workforce; shown only when one group, one group type and one year are selected.
Companies with a women-in-workforce share =
    IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[companies_with_female_workforce] ) )

// [1 Coverage] companies. How many companies have a report in the group and year. Published value from rpt_public_group_metrics.companies_reporting; shown only when one group, one group type and one year are selected.
Companies reporting =
    IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[companies_reporting] ) )

// [2 Intensity and shares (group)] %. Out of every 100 company reports, how many give a Scope 3 emissions figure. Published value from rpt_public_group_metrics.scope3_disclosed_share; shown only when one group, one group type and one year are selected. Blank when withheld: see 'Withheld note'.
Companies disclosing Scope 3 (%) =
    IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[scope3_disclosed_share] ) )

// [3 Disclosure quality (group)] points (0-100). The average Disclosure Quality Score of the group. Compare within one financial year only. Published value from rpt_public_group_metrics.dqs_avg; shown only when one group, one group type and one year are selected. Blank when withheld: see 'Withheld note'.
Disclosure Quality Score, average =
    IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[dqs_avg] ) )

// [3 Disclosure quality (group)] points (0-100). The Disclosure Quality Score of the company in the middle of the group. Published value from rpt_public_group_metrics.dqs_median; shown only when one group, one group type and one year are selected. Blank when withheld: see 'Withheld note'.
Disclosure Quality Score, typical company =
    IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[dqs_median] ) )

// [3 Disclosure quality (group)] %. Out of every 100 graded company reports, how many reach grade A (85 points or more). Published value from rpt_public_group_metrics.dqs_grade_a_share; shown only when one group, one group type and one year are selected. Blank when withheld: see 'Withheld note'.
Company-years graded A (%) =
    IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[dqs_grade_a_share] ) )

// [3 Disclosure quality (group)] share (0-1). On average, the share of the voluntary (Leadership) indicators that the companies of the group answered. Published value from rpt_public_group_metrics.voluntary_depth_avg; shown only when one group, one group type and one year are selected. Blank when withheld: see 'Withheld note'.
Voluntary depth, average =
    IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[voluntary_depth_avg] ) )

// [1 Coverage] companies. How many companies of the group have a Disclosure Quality Score. Published value from rpt_public_group_metrics.companies_with_dqs; shown only when one group, one group type and one year are selected.
Companies with a Disclosure Quality Score =
    IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[companies_with_dqs] ) )

// [1 Coverage] companies. How many companies of the group have a grade (at least three components scored). Published value from rpt_public_group_metrics.companies_with_dqs_grade; shown only when one group, one group type and one year are selected.
Companies with a Disclosure Quality grade =
    IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[companies_with_dqs_grade] ) )

// [1 Coverage] companies. How many companies of the group have a voluntary depth figure. Published value from rpt_public_group_metrics.companies_with_voluntary_depth; shown only when one group, one group type and one year are selected.
Companies with a voluntary depth =
    IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[companies_with_voluntary_depth] ) )

// [1 Coverage] restated values. How many figures were changed materially in the next year's report. A restatement is not wrongdoing. Published value from rpt_public_group_metrics.material_restatements; shown only when one group, one group type and one year are selected.
Material restatements =
    IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[material_restatements] ) )

// [4 Restatements (group)] %. Out of every 100 figures that could be compared with the next year's report, how many were changed materially. Published value from rpt_public_group_metrics.material_restatement_share; shown only when one group, one group type and one year are selected. Blank when withheld: see 'Withheld note'.
Figures materially restated (%) =
    IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[material_restatement_share] ) )

// [1 Coverage] values. How many figures are more than 100 times apart from the next year's report: unit slips, not restatements. Published value from rpt_public_group_metrics.suspected_scale_errors; shown only when one group, one group type and one year are selected.
Suspected scale errors =
    IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[suspected_scale_errors] ) )

// [1 Coverage] companies. How many companies of the group have at least one figure that could be compared with the next year's report. Published value from rpt_public_group_metrics.companies_with_compared_restatements; shown only when one group, one group type and one year are selected.
Companies with compared figures =
    IF ( COUNTROWS ( rpt_public_group_metrics ) = 1, MAX ( rpt_public_group_metrics[companies_with_compared_restatements] ) )

// [7 Company card] The selected company's ghg_intensity_tco2e_per_cr in the selected year (computed by ESG Lens India; public).
Company: GHG intensity =
    SELECTEDVALUE ( rpt_public_company_year[ghg_intensity_tco2e_per_cr] )

// [7 Company card] The selected company's energy_intensity_gj_per_cr in the selected year (computed by ESG Lens India; public).
Company: energy intensity =
    SELECTEDVALUE ( rpt_public_company_year[energy_intensity_gj_per_cr] )

// [7 Company card] The selected company's water_intensity_kl_per_cr in the selected year (computed by ESG Lens India; public).
Company: water intensity =
    SELECTEDVALUE ( rpt_public_company_year[water_intensity_kl_per_cr] )

// [7 Company card] The selected company's waste_intensity_t_per_cr in the selected year (computed by ESG Lens India; public).
Company: waste intensity =
    SELECTEDVALUE ( rpt_public_company_year[waste_intensity_t_per_cr] )

// [7 Company card] The selected company's renewable_share_pct in the selected year (computed by ESG Lens India; public).
Company: renewable share (%) =
    SELECTEDVALUE ( rpt_public_company_year[renewable_share_pct] )

// [7 Company card] The selected company's female_workforce_pct in the selected year (computed by ESG Lens India; public).
Company: women in workforce (%) =
    SELECTEDVALUE ( rpt_public_company_year[female_workforce_pct] )

// [7 Company card] The selected company's pay_equity_gap_pp in the selected year (computed by ESG Lens India; public).
Company: pay-equity gap (pp) =
    SELECTEDVALUE ( rpt_public_company_year[pay_equity_gap_pp] )

// [7 Company card] The selected company's dqs_total in the selected year.
Company: DQS =
    SELECTEDVALUE ( rpt_public_disclosure_quality[dqs_total] )

// [7 Company card] The selected company's dqs_grade in the selected year.
Company: DQS grade =
    SELECTEDVALUE ( rpt_public_disclosure_quality[dqs_grade] )

// [7 Company card] The selected company's dqs_rank_in_group in the selected year.
Company: DQS rank in group =
    SELECTEDVALUE ( rpt_public_disclosure_quality[dqs_rank_in_group] )

// [7 Company card] The selected company's dqs_percentile_in_group in the selected year.
Company: DQS percentile in group =
    SELECTEDVALUE ( rpt_public_disclosure_quality[dqs_percentile_in_group] )

// [7 Company card] Provisional = the latest year: no later report has confirmed the figures yet.
Company: data status =
    IF ( SELECTEDVALUE ( rpt_public_disclosure_quality[is_provisional] ), "Provisional", "Final" )

// [6 Concentration (shares)] 1 = largest Scope 1+2 emitter of the year among all companies covered.
Emitter rank =
    SELECTEDVALUE ( rpt_public_concentration[emitter_rank] )

// [6 Concentration (shares)] The company's share of the Scope 1+2 emissions of all companies covered that year, in %. Use with dim_company[display_name] on the axis and one year selected.
Share of total emissions (%) =
    SELECTEDVALUE ( rpt_public_concentration[share_of_total_pct] )

// [6 Concentration (shares)] Share held by this company and every larger emitter together, in %: the Pareto line.
Cumulative share of emissions (%) =
    SELECTEDVALUE ( rpt_public_concentration[cumulative_share_pct] )

// [6 Concentration (shares)] Share of the year's Scope 1+2 emissions held by the 5 largest emitters, in %. Select one year; company and group slicers are ignored on purpose (the share is of all companies covered).
Top-5 share of emissions (%) =
    CALCULATE (
        SELECTEDVALUE ( rpt_public_concentration[cumulative_share_pct] ),
        rpt_public_concentration[emitter_rank] = 5,
        REMOVEFILTERS ( dim_company )
    )

// [6 Concentration (shares)] Share of the year's Scope 1+2 emissions held by the 10 largest emitters, in %. Select one year; company and group slicers are ignored on purpose (the share is of all companies covered).
Top-10 share of emissions (%) =
    CALCULATE (
        SELECTEDVALUE ( rpt_public_concentration[cumulative_share_pct] ),
        rpt_public_concentration[emitter_rank] = 10,
        REMOVEFILTERS ( dim_company )
    )

// [6 Concentration (shares)] How many of the largest emitters it takes to reach 80% of the year's Scope 1+2 emissions. Select one year.
Companies for 80% of emissions =
    VAR below_80 =
        CALCULATE (
            COUNTROWS ( rpt_public_concentration ),
            rpt_public_concentration[cumulative_share_pct] < 80,
            REMOVEFILTERS ( dim_company )
        )
    RETURN
        IF ( HASONEVALUE ( dim_fiscal_year[fiscal_year_label] ), below_80 + 1 )

// [7 Company card] Percentile in the ranking group for the KPI on the row (100 = best). Put kpi_label on the rows of a table and select one company and year.
Company: peer percentile =
    SELECTEDVALUE ( rpt_public_company_percentile[percentile_in_group] )

// [7 Company card] Rank in the ranking group for the KPI on the row (1 = best).
Company: rank in group =
    SELECTEDVALUE ( rpt_public_company_percentile[rank_in_group] )

// [7 Company card] Companies of the ranking group with a value of the KPI: the base of the rank. Below 5 there is no rank.
Company: companies in group =
    SELECTEDVALUE ( rpt_public_company_percentile[n_in_group] )

// [7 Company card] The company's value of the KPI on the row, only for KPIs we compute (empty for filed values).
Company: KPI value (public KPIs) =
    SELECTEDVALUE ( rpt_public_company_percentile[kpi_value_public] )

// [7 Company card] Why the KPI on the row has a rank or not. A KPI that is not material for the ranking group is not ranked, although its group median is still shown as a description.
Company: ranking status =
    VAR ranked = SELECTEDVALUE ( rpt_public_company_percentile[is_ranked] )
    VAR reason = SELECTEDVALUE ( rpt_public_company_percentile[reason_not_ranked] )
    RETURN
        SWITCH (
            TRUE (),
            ranked = TRUE (), "ranked",
            reason = "not_material", "not ranked for this group (not material)",
            reason = "group_n_lt_5", "not ranked: fewer than 5 companies (n<5)",
            reason = "flagged_value", "not ranked: value flagged",
            reason = "no_direction", "not ranked: no better or worse direction",
            BLANK ()
        )

// [2 Intensity and shares (group)] Label for a ranking group's GHG intensity median: companies are not ranked on it in this group because the KPI is not material there (for example GHG intensity for Financials). The median is still shown, as a description of the group.
Ranking note: GHG intensity =
    VAR group_type = SELECTEDVALUE ( rpt_public_group_metrics[group_type] )
    VAR ranking_group = SELECTEDVALUE ( rpt_public_group_metrics[group_value] )
    VAR fiscal_year = SELECTEDVALUE ( rpt_public_group_metrics[fiscal_year_label] )
    VAR not_material =
        CALCULATE (
            COUNTROWS ( rpt_public_company_percentile ),
            REMOVEFILTERS ( rpt_public_company_percentile ),
            rpt_public_company_percentile[ranking_group] = ranking_group,
            rpt_public_company_percentile[fiscal_year_label] = fiscal_year,
            rpt_public_company_percentile[kpi_name] = "ghg_intensity_tco2e_per_cr",
            rpt_public_company_percentile[reason_not_ranked] = "not_material"
        )
    RETURN
        IF ( group_type = "ranking_group" && not_material > 0, "not ranked for this group (not material)" )

// [2 Intensity and shares (group)] Label for a ranking group's energy intensity median: companies are not ranked on it in this group because the KPI is not material there (for example GHG intensity for Financials). The median is still shown, as a description of the group.
Ranking note: energy intensity =
    VAR group_type = SELECTEDVALUE ( rpt_public_group_metrics[group_type] )
    VAR ranking_group = SELECTEDVALUE ( rpt_public_group_metrics[group_value] )
    VAR fiscal_year = SELECTEDVALUE ( rpt_public_group_metrics[fiscal_year_label] )
    VAR not_material =
        CALCULATE (
            COUNTROWS ( rpt_public_company_percentile ),
            REMOVEFILTERS ( rpt_public_company_percentile ),
            rpt_public_company_percentile[ranking_group] = ranking_group,
            rpt_public_company_percentile[fiscal_year_label] = fiscal_year,
            rpt_public_company_percentile[kpi_name] = "energy_intensity_gj_per_cr",
            rpt_public_company_percentile[reason_not_ranked] = "not_material"
        )
    RETURN
        IF ( group_type = "ranking_group" && not_material > 0, "not ranked for this group (not material)" )

// [2 Intensity and shares (group)] Label for a ranking group's water intensity median: companies are not ranked on it in this group because the KPI is not material there (for example GHG intensity for Financials). The median is still shown, as a description of the group.
Ranking note: water intensity =
    VAR group_type = SELECTEDVALUE ( rpt_public_group_metrics[group_type] )
    VAR ranking_group = SELECTEDVALUE ( rpt_public_group_metrics[group_value] )
    VAR fiscal_year = SELECTEDVALUE ( rpt_public_group_metrics[fiscal_year_label] )
    VAR not_material =
        CALCULATE (
            COUNTROWS ( rpt_public_company_percentile ),
            REMOVEFILTERS ( rpt_public_company_percentile ),
            rpt_public_company_percentile[ranking_group] = ranking_group,
            rpt_public_company_percentile[fiscal_year_label] = fiscal_year,
            rpt_public_company_percentile[kpi_name] = "water_intensity_kl_per_cr",
            rpt_public_company_percentile[reason_not_ranked] = "not_material"
        )
    RETURN
        IF ( group_type = "ranking_group" && not_material > 0, "not ranked for this group (not material)" )

// [2 Intensity and shares (group)] Label for a ranking group's waste intensity median: companies are not ranked on it in this group because the KPI is not material there (for example GHG intensity for Financials). The median is still shown, as a description of the group.
Ranking note: waste intensity =
    VAR group_type = SELECTEDVALUE ( rpt_public_group_metrics[group_type] )
    VAR ranking_group = SELECTEDVALUE ( rpt_public_group_metrics[group_value] )
    VAR fiscal_year = SELECTEDVALUE ( rpt_public_group_metrics[fiscal_year_label] )
    VAR not_material =
        CALCULATE (
            COUNTROWS ( rpt_public_company_percentile ),
            REMOVEFILTERS ( rpt_public_company_percentile ),
            rpt_public_company_percentile[ranking_group] = ranking_group,
            rpt_public_company_percentile[fiscal_year_label] = fiscal_year,
            rpt_public_company_percentile[kpi_name] = "waste_intensity_t_per_cr",
            rpt_public_company_percentile[reason_not_ranked] = "not_material"
        )
    RETURN
        IF ( group_type = "ranking_group" && not_material > 0, "not ranked for this group (not material)" )

// [7 Company card] The published ghg_intensity_median of the selected company's ranking group and year (blank when withheld, n<5). MAX picks the one matching row.
Peer median: GHG intensity =
    VAR ranking_group = SELECTEDVALUE ( rpt_public_company_year[ranking_group] )
    VAR fiscal_year = SELECTEDVALUE ( rpt_public_company_year[fiscal_year_label] )
    RETURN
        CALCULATE (
            MAX ( rpt_public_group_metrics[ghg_intensity_median] ),
            REMOVEFILTERS ( rpt_public_group_metrics ),
            rpt_public_group_metrics[group_type] = "ranking_group",
            rpt_public_group_metrics[group_value] = ranking_group,
            rpt_public_group_metrics[fiscal_year_label] = fiscal_year
        )

// [7 Company card] The published dqs_median of the selected company's ranking group and year (blank when withheld, n<5). MAX picks the one matching row.
Peer median: DQS =
    VAR ranking_group = SELECTEDVALUE ( rpt_public_company_year[ranking_group] )
    VAR fiscal_year = SELECTEDVALUE ( rpt_public_company_year[fiscal_year_label] )
    RETURN
        CALCULATE (
            MAX ( rpt_public_group_metrics[dqs_median] ),
            REMOVEFILTERS ( rpt_public_group_metrics ),
            rpt_public_group_metrics[group_type] = "ranking_group",
            rpt_public_group_metrics[group_value] = ranking_group,
            rpt_public_group_metrics[fiscal_year_label] = fiscal_year
        )
