# Copy to .env and edit:  Copy-Item .env.example .env
# Relative paths are resolved from the repo root by ingestion/config.py.
# There are no HTTP settings: nothing is downloaded automatically (docs/adr/0002).

# DuckDB warehouse file. Leave commented to use the default (data/warehouse/esg_lens.duckdb).
# dbt >= 1.12 also reads this .env but runs from dbt/, so a RELATIVE path would point to the
# wrong place there. If you override it, use an ABSOLUTE path, e.g.:
# DUCKDB_PATH=C:/esg-lens-india/data/warehouse/esg_lens.duckdb

# Root of raw / processed data
DATA_DIR=data

# Data folder as seen by dbt (dbt runs from dbt/). Staging views read the files when queried, so
# use an ABSOLUTE path. scripts/dev.ps1 and the Makefile set it automatically when it is unset.
# ESG_DATA_DIR=C:/esg-lens-india/data

# AI analyst (optional, local; docs/ai_analyst.md). Read by `.\scripts\dev.ps1 app` / `eval` through
# scripts/run_local.py, which copies only the ESG_AI_* settings, OLLAMA_HOST and the API keys.
# ESG_AI_ENABLED=true
# ESG_AI_PROVIDER=gemini
# The Gemini key goes in YOUR .env only, as a line GEMINI_API_KEY followed by = and the key
# (never in this file, never in code). Free tier only: NEVER enable billing on its Google project.
