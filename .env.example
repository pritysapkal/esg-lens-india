# Copy to .env and edit:  Copy-Item .env.example .env
# Relative paths are resolved from the repo root by ingestion/config.py.
# There are no HTTP settings: nothing is downloaded automatically (docs/adr/0002).

# DuckDB warehouse file. Leave commented to use the default (data/warehouse/esg_lens.duckdb).
# dbt >= 1.12 also reads this .env but runs from dbt/, so a RELATIVE path would point to the
# wrong place there. If you override it, use an ABSOLUTE path, e.g.:
# DUCKDB_PATH=C:/esg-lens-india/data/warehouse/esg_lens.duckdb

# Root of raw / processed data
DATA_DIR=data
